---
import ExperienceItem from "./experienceItem.astro";

const EXPERIENCE = [
  {
    dateKey: "exp_1_date",
    titleKey: "exp_1_title",
    title2Key: "exp_1_company",
    descriptionKey: "exp_1_desc",
  },
  {
    dateKey: "exp_2_date",
    titleKey: "exp_2_title",
    title2Key: "exp_2_company",
    descriptionKey: "exp_2_desc",
  },
  {
    dateKey: "exp_3_date",
    titleKey: "exp_3_title",
    title2Key: "exp_3_company",
    descriptionKey: "exp_3_desc",
  },
];
---

<ol class="relative mt-12">
  {EXPERIENCE.map((exp) => (
    <li class="">
      <ExperienceItem {...exp} />
    </li>
  ))}
</ol>