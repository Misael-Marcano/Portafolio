---
import ThemeToggle from "./ThemeToggle.astro";

/** Juego independiente en GitHub Pages (repo separado). */
const GAME_URL = "https://misael-marcano.github.io/Bug-Hunter/";
---

<header class="fixed top-0 z-50 flex flex-col items-center justify-center w-full max-w-[100vw] mt-3 px-3 sm:px-4">
  <!-- Ventana de editor: barra de título + pestañas -->
  <nav
    id="main-nav"
    class="flex items-center justify-center gap-x-1.5 sm:gap-x-2 pl-2 sm:pl-3 pr-1.5 sm:pr-2 py-1.5 text-[13px] font-mono rounded-xl
           text-tn-muted max-w-full
           transition-all duration-300"
  >
    <!-- Botones PlayStation (solo desktop amplio) -->
    <div
      class="hidden lg:flex items-center gap-2 mr-2 shrink-0 font-mono text-[11px] select-none"
      aria-hidden="true"
    >
      <span class="ps-sym text-[#2dd4bf]">△</span>
      <span class="ps-sym text-[#f7768e]">○</span>
      <span class="ps-sym text-[#7aa2f7]">✕</span>
      <span class="ps-sym text-[#bb9af7]">□</span>
    </div>

    <!-- Pestañas (desktop ≥ md; móvil usa menú hamburguesa) -->
    <a
      href="#top"
      data-i18n="nav_home"
      class="nav-link relative hidden md:block px-2.5 py-1.5 rounded-md transition whitespace-nowrap hover:text-tn-cyan hover:bg-tn-panel-2"
    >
      Inicio
    </a>

    <a
      href="#experiencia"
      data-i18n="nav_experience"
      class="nav-link relative hidden md:block px-2.5 py-1.5 rounded-md transition whitespace-nowrap hover:text-tn-cyan hover:bg-tn-panel-2"
    >
      Experiencia
    </a>

    <a
      href="#proyectos"
      data-i18n="nav_projects"
      class="nav-link relative hidden md:block px-2.5 py-1.5 rounded-md transition whitespace-nowrap hover:text-tn-cyan hover:bg-tn-panel-2"
    >
      Proyectos
    </a>

    <a
      href="#preparacion"
      data-i18n="nav_prep"
      class="nav-link relative hidden md:block px-2.5 py-1.5 rounded-md transition whitespace-nowrap hover:text-tn-cyan hover:bg-tn-panel-2"
    >
      Preparación
    </a>

    <a
      href="#sobremi"
      data-i18n="nav_about"
      class="nav-link relative hidden md:block px-2.5 py-1.5 rounded-md transition whitespace-nowrap hover:text-tn-cyan hover:bg-tn-panel-2"
    >
      Sobre mí
    </a>

    <!-- Separador -->
    <div class="hidden md:block w-px h-5 bg-tn-border/60 mx-1 shrink-0"></div>

    <!-- Toggle de idioma -->
    <div
      class="relative flex items-center rounded-md p-1 h-10 w-[5.75rem] sm:h-8 sm:w-24
             bg-tn-panel-2
             border border-tn-border/50 shrink-0"
      aria-label="Cambiar idioma"
    >
      <div
        id="lang-indicator"
        class="absolute top-1 bottom-1 w-[2.6rem] sm:w-11 rounded transition-all duration-300 ease-in-out shadow-sm
               bg-tn-blue shrink-0"
        style="left: 4px;"
      ></div>

      <button
        id="btn-es"
        type="button"
        class="relative z-10 w-1/2 h-full text-[10px] font-bold transition-colors duration-300
               text-tn-bg cursor-pointer"
      >
        ES
      </button>

      <button
        id="btn-en"
        type="button"
        class="relative z-10 w-1/2 h-full text-[10px] font-bold transition-colors duration-300
               text-tn-muted cursor-pointer"
      >
        EN
      </button>
    </div>

    <!-- DualSense: lanza el videojuego en GitHub Pages -->
    <a
      id="game-launch-btn"
      href={GAME_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="ds-launch inline-flex items-center justify-center min-h-10 min-w-10 sm:min-h-0 sm:min-w-0 px-2 py-1.5 sm:px-1.5 sm:py-1 rounded-md
             transition-all duration-300
             border border-tn-border/50 bg-tn-panel-2/60
             hover:border-tn-cyan/60"
      aria-label="Abrir videojuego"
      title="PLAY — Bug Hunter"
      data-i18n-attr="aria-label"
      data-i18n-aria-label="game_launch_label"
    >
      <svg viewBox="0 0 32 20" class="w-8 h-5" fill="none" aria-hidden="true">
        <path
          class="ds-body"
          d="M9 2.6 C5.2 2.6 3.3 5.5 2.7 9.2 C2.1 13.4 2.7 17.1 5 17.4 C7.2 17.7 8.2 14.7 9.6 13.3 L22.4 13.3 C23.8 14.7 24.8 17.7 27 17.4 C29.3 17.1 29.9 13.4 29.3 9.2 C28.7 5.5 26.8 2.6 23 2.6 Z"
          stroke-width="1"
        ></path>
        <path
          class="ds-lightbar"
          d="M12.5 2.7 Q16 5.3 19.5 2.7"
          stroke-width="1.7"
          stroke-linecap="round"
        ></path>
        <path
          class="ds-detail"
          d="M7 6.9 v3.2 M5.4 8.5 h3.2"
          stroke-width="1.1"
          stroke-linecap="round"
        ></path>
        <circle class="ds-detail-fill" cx="25" cy="6.7" r="0.9"></circle>
        <circle class="ds-detail-fill" cx="25" cy="10.3" r="0.9"></circle>
        <circle class="ds-detail-fill" cx="23.2" cy="8.5" r="0.9"></circle>
        <circle class="ds-detail-fill" cx="26.8" cy="8.5" r="0.9"></circle>
        <circle class="ds-stick" cx="12.7" cy="11.4" r="1.7" stroke-width="1"></circle>
        <circle class="ds-stick" cx="19.3" cy="11.4" r="1.7" stroke-width="1"></circle>
      </svg>
    </a>

    <!-- Tema: icono mini consola DevTools -->
    <ThemeToggle />

    <button
      id="menu-toggle-btn"
      type="button"
      class="md:hidden inline-flex items-center justify-center min-h-10 min-w-10 p-2 rounded-md hover:bg-tn-panel-2
             transition-colors duration-300 cursor-pointer
             text-tn-muted"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="md:hidden hidden mt-2 w-full px-3 sm:px-4"
  >
    <div
      class="mx-auto w-full max-w-xs flex flex-col gap-1 px-3 py-3 rounded-xl font-mono text-[13px]
             text-tn-muted
             bg-tn-panel/90
             border border-tn-border/60
             backdrop-blur-md"
    >
      <a href="#top" data-i18n="nav_home" class="nav-link block px-3 py-2.5 rounded-md whitespace-nowrap hover:text-tn-cyan hover:bg-tn-panel-2">
        Inicio
      </a>
      <a href="#experiencia" data-i18n="nav_experience" class="nav-link block px-3 py-2.5 rounded-md whitespace-nowrap hover:text-tn-cyan hover:bg-tn-panel-2">
        Experiencia
      </a>
      <a href="#proyectos" data-i18n="nav_projects" class="nav-link block px-3 py-2.5 rounded-md whitespace-nowrap hover:text-tn-cyan hover:bg-tn-panel-2">
        Proyectos
      </a>
      <a href="#preparacion" data-i18n="nav_prep" class="nav-link block px-3 py-2.5 rounded-md whitespace-nowrap hover:text-tn-cyan hover:bg-tn-panel-2">
        Preparación
      </a>
      <a href="#sobremi" data-i18n="nav_about" class="nav-link block px-3 py-2.5 rounded-md whitespace-nowrap hover:text-tn-cyan hover:bg-tn-panel-2">
        Sobre mí
      </a>
    </div>
  </div>
</header>

<style>
  #main-nav {
    animation: nav-shadow 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadow {
    from {
      background-color: transparent;
      backdrop-filter: blur(0px);
      box-shadow: none;
      border: 1px solid transparent;
    }
    to {
      background-color: color-mix(in srgb, var(--tn-panel) 85%, transparent);
      backdrop-filter: blur(12px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
      border: 1px solid var(--tn-border);
    }
  }

  /* Pestaña activa (scroll-spy): borde superior cian + punto "sin guardar" */
  #main-nav a.nav-link.active,
  #mobile-menu a.nav-link.active {
    color: var(--tn-cyan);
    background: var(--tn-panel-2);
  }
  #main-nav a.nav-link.active::before {
    content: "";
    position: absolute;
    top: 0;
    left: 6px;
    right: 6px;
    height: 2px;
    border-radius: 2px;
    background: var(--tn-cyan);
  }
  #main-nav a.nav-link.active::after,
  #mobile-menu a.nav-link.active::after {
    content: "●";
    font-size: 8px;
    margin-left: 6px;
    vertical-align: middle;
    color: var(--tn-cyan);
  }

  /* ===== DualSense → lanzar juego (LED siempre “ready”) ===== */
  .ds-launch:hover svg {
    transform: scale(1.08);
  }
  .ds-launch svg {
    transition: transform 0.3s ease;
  }
  .ds-body {
    fill: var(--tn-panel-2);
    stroke: var(--tn-muted);
  }
  .ds-detail {
    stroke: var(--tn-muted);
  }
  .ds-detail-fill {
    fill: var(--tn-muted);
  }
  .ds-stick {
    fill: var(--tn-panel);
    stroke: var(--tn-muted);
  }

  .ds-lightbar {
    stroke: #2e7de9;
    filter: drop-shadow(0 0 3px #2e7de9);
    opacity: 1;
    animation: ds-ready-pulse 2.4s ease-in-out infinite;
  }
  :global(.dark) .ds-lightbar {
    stroke: #7aa2f7;
    filter: drop-shadow(0 0 4px #7aa2f7);
  }
  @keyframes ds-ready-pulse {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-lightbar {
      animation: none;
    }
  }
</style>

<script is:inline>
  const initHeaderControls = () => {
    const btnEs = document.getElementById("btn-es");
    const btnEn = document.getElementById("btn-en");
    const indicator = document.getElementById("lang-indicator");
    const nav = document.getElementById("main-nav");

    // Desktop links + Mobile links (para marcar active en ambos)
    const navLinksDesktop = Array.from(document.querySelectorAll("#main-nav a.nav-link"));
    const navLinksMobile = Array.from(document.querySelectorAll("#mobile-menu a.nav-link"));
    const navLinks = [...navLinksDesktop, ...navLinksMobile];

    // Mobile menu toggle
    const menuBtn = document.getElementById("menu-toggle-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    if (!nav || !indicator || !btnEs || !btnEn || navLinks.length === 0) return;

    const toggleMobileMenu = (open) => {
      if (!menuBtn || !mobileMenu) return;
      const willOpen = typeof open === "boolean" ? open : mobileMenu.classList.contains("hidden");
      mobileMenu.classList.toggle("hidden", !willOpen);
      menuBtn.setAttribute("aria-expanded", String(willOpen));
    };

    menuBtn?.addEventListener("click", () => toggleMobileMenu());
    // Cierra menú si haces click fuera (móvil)
    document.addEventListener("click", (e) => {
      if (!mobileMenu || mobileMenu.classList.contains("hidden")) return;
      const target = e.target;
      if (!(target instanceof Node)) return;
      if (!nav.contains(target) && !mobileMenu.contains(target)) toggleMobileMenu(false);
    });

    // ---- Idioma ----
    const paintLangIndicator = () => {
      const currentLang = localStorage.getItem("language") === "en" ? "en" : "es";
      const track = indicator.parentElement;
      const btnWidth = track ? track.clientWidth / 2 : 44;
      const inset = 4;

      if (currentLang === "es") {
        indicator.style.left = `${inset}px`;
        indicator.style.width = `${Math.max(0, btnWidth - inset)}px`;
        btnEs.classList.add("text-tn-bg");
        btnEs.classList.remove("text-tn-muted");
        btnEn.classList.remove("text-tn-bg");
        btnEn.classList.add("text-tn-muted");
      } else {
        indicator.style.left = `${btnWidth}px`;
        indicator.style.width = `${Math.max(0, btnWidth - inset)}px`;
        btnEn.classList.add("text-tn-bg");
        btnEn.classList.remove("text-tn-muted");
        btnEs.classList.remove("text-tn-bg");
        btnEs.classList.add("text-tn-muted");
      }
    };

    // ---- Helpers ----
    const normalizeHash = (href) => {
      try {
        const url = new URL(href, window.location.origin);
        return url.hash || "#top";
      } catch {
        if (href.startsWith("#")) return href;
        const idx = href.indexOf("#");
        return idx !== -1 ? href.slice(idx) : "#top";
      }
    };

    const getTargetIdFromLink = (link) => {
      const href = link.getAttribute("href") || "#top";
      const hash = normalizeHash(href);
      return hash === "#top" ? null : hash.substring(1);
    };

    const setActiveByHash = (hash) => {
      navLinks.forEach((l) => l.classList.remove("active"));
      const link = navLinks.find((l) => normalizeHash(l.getAttribute("href") || "") === hash);
      if (link) link.classList.add("active");
    };

    // ---- Scroll spy estable ----
    let sections = [];
    let ticking = false;

    const getFixedNavHeight = () => {
      const navEl = document.getElementById("main-nav");
      if (!navEl) return 72;
      const rect = navEl.getBoundingClientRect();
      return Math.ceil(rect.height + 16);
    };

    const computeSections = () => {
      // solo ids de los links DESKTOP (son los mismos)
      const ids = navLinksDesktop.map(getTargetIdFromLink).filter(Boolean);
      sections = ids
        .map((id) => {
          const el = document.getElementById(id);
          if (!el) return null;
          return { id, el };
        })
        .filter(Boolean);
    };

    const updateActiveSection = () => {
      ticking = false;

      if (window.scrollY < 80) {
        setActiveByHash("#top");
        return;
      }

      // Al llegar al final de la página, activa la última sección
      // (su tope nunca alcanza a pasar bajo el nav)
      const nearBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 4;
      if (nearBottom && sections.length > 0) {
        setActiveByHash(`#${sections[sections.length - 1].id}`);
        return;
      }

      const offset = getFixedNavHeight();
      const probeY = window.scrollY + offset;

      let currentId = null;
      for (let i = 0; i < sections.length; i++) {
        const { id, el } = sections[i];
        if (el.offsetTop <= probeY) currentId = id;
        else break;
      }

      if (currentId) setActiveByHash(`#${currentId}`);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateActiveSection);
    };

    // Click: scroll con compensación + cierra menú móvil
    navLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const id = getTargetIdFromLink(link);

        if (!id) {
          e.preventDefault();
          setActiveByHash("#top");
          window.scrollTo({ top: 0, behavior: "smooth" });
          toggleMobileMenu(false);
          return;
        }

        const target = document.getElementById(id);
        if (!target) return;

        e.preventDefault();

        const offset = getFixedNavHeight();
        const y = target.offsetTop - offset;

        window.scrollTo({ top: y, behavior: "smooth" });
        setActiveByHash(`#${id}`);
        toggleMobileMenu(false);
      });
    });

    // ---- Idioma ----
    btnEs?.addEventListener("click", () => {
      if (typeof window.changeLanguage === "function") window.changeLanguage("es");
      localStorage.setItem("language", "es");
      paintLangIndicator();
      setTimeout(() => {
        computeSections();
        updateActiveSection();
      }, 50);
    });

    btnEn?.addEventListener("click", () => {
      if (typeof window.changeLanguage === "function") window.changeLanguage("en");
      localStorage.setItem("language", "en");
      paintLangIndicator();
      setTimeout(() => {
        computeSections();
        updateActiveSection();
      }, 50);
    });

    // Listeners
    window.addEventListener("languageChange", paintLangIndicator);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener(
      "resize",
      () => {
        computeSections();
        updateActiveSection();
        paintLangIndicator();
        // Solo cierra el menú al pasar a desktop (≥ md)
        if (window.matchMedia("(min-width: 768px)").matches) {
          toggleMobileMenu(false);
        }
      },
      { passive: true }
    );

    // Inicializar
    paintLangIndicator();
    computeSections();
    updateActiveSection();

    // Astro swaps
    document.addEventListener("astro:after-swap", () => {
      paintLangIndicator();
      computeSections();
      updateActiveSection();
      toggleMobileMenu(false);
    });
  };

  if (document.readyState === "loading") {
    window.addEventListener("DOMContentLoaded", initHeaderControls, { once: true });
  } else {
    initHeaderControls();
  }
</script>
