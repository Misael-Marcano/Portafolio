---
---

<!-- Lámpara gaming: encendida en claro, apagada en oscuro -->
<button
  id="theme-toggle-btn"
  type="button"
  class="lamp-toggle inline-flex items-center justify-center min-h-10 min-w-10 sm:min-h-0 sm:min-w-0 px-2 py-1.5 sm:px-1.5 sm:py-1 rounded-md
         transition-all duration-300 cursor-pointer
         border border-tn-border/50 bg-tn-panel-2/60
         hover:border-tn-yellow/60"
  aria-label="Cambiar tema"
  title="Toggle desk lamp"
  data-i18n-attr="aria-label"
  data-i18n-aria-label="theme_toggle_label"
>
  <svg viewBox="0 0 24 22" class="w-6 h-5" fill="none" aria-hidden="true">
    <!-- Haz de luz (solo visible encendida) -->
    <path
      class="lamp-beam"
      d="M7 11 L3.5 19.5 H20.5 L17 11 Z"
      stroke="none"
    ></path>
    <!-- Pantalla / head -->
    <path
      class="lamp-shade"
      d="M6.5 11 C6.5 6.2 9.2 3.2 12 3.2 C14.8 3.2 17.5 6.2 17.5 11 Z"
      stroke-width="1.25"
      stroke-linejoin="round"
    ></path>
    <!-- Bombilla -->
    <circle class="lamp-bulb" cx="12" cy="9.2" r="2.2" stroke-width="1.1"></circle>
    <!-- Brazo -->
    <path
      class="lamp-arm"
      d="M12 11 V15.5"
      stroke-width="1.35"
      stroke-linecap="round"
    ></path>
    <!-- Base -->
    <path
      class="lamp-base"
      d="M8.5 18.8 H15.5"
      stroke-width="1.6"
      stroke-linecap="round"
    ></path>
    <path
      class="lamp-base"
      d="M7 20.4 H17"
      stroke-width="1.35"
      stroke-linecap="round"
    ></path>
  </svg>
</button>

<style>
  .lamp-toggle:hover svg {
    transform: scale(1.08);
  }
  .lamp-toggle svg {
    transition: transform 0.3s ease;
  }

  .lamp-shade,
  .lamp-arm,
  .lamp-base {
    stroke: var(--tn-muted);
    fill: none;
    transition:
      stroke 0.4s ease,
      fill 0.4s ease,
      filter 0.4s ease,
      opacity 0.4s ease;
  }

  .lamp-bulb {
    fill: var(--tn-comment);
    stroke: var(--tn-muted);
    transition:
      fill 0.4s ease,
      stroke 0.4s ease,
      filter 0.4s ease,
      opacity 0.4s ease;
  }

  .lamp-beam {
    fill: transparent;
    opacity: 0;
    transition:
      fill 0.4s ease,
      opacity 0.4s ease;
  }

  /* Claro = lámpara ENCENDIDA */
  :global(html:not(.dark)) .lamp-shade {
    stroke: var(--tn-yellow);
    fill: color-mix(in srgb, var(--tn-yellow) 18%, transparent);
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--tn-yellow) 55%, transparent));
  }
  :global(html:not(.dark)) .lamp-bulb {
    fill: #ffe08a;
    stroke: var(--tn-yellow);
    filter: drop-shadow(0 0 4px #e0af68);
  }
  :global(html:not(.dark)) .lamp-arm,
  :global(html:not(.dark)) .lamp-base {
    stroke: var(--tn-muted);
  }
  :global(html:not(.dark)) .lamp-beam {
    fill: color-mix(in srgb, var(--tn-yellow) 28%, transparent);
    opacity: 1;
  }

  /* Oscuro = lámpara APAGADA */
  :global(.dark) .lamp-shade {
    stroke: var(--tn-comment);
    fill: color-mix(in srgb, var(--tn-panel) 80%, transparent);
    filter: none;
    opacity: 0.75;
  }
  :global(.dark) .lamp-bulb {
    fill: var(--tn-panel-2);
    stroke: var(--tn-comment);
    filter: none;
    opacity: 0.55;
  }
  :global(.dark) .lamp-arm,
  :global(.dark) .lamp-base {
    stroke: var(--tn-comment);
    opacity: 0.7;
  }
  :global(.dark) .lamp-beam {
    opacity: 0;
  }

  .lamp-toggle:hover {
    border-color: color-mix(in srgb, var(--tn-yellow) 55%, transparent);
  }
  :global(.dark) .lamp-toggle:hover {
    border-color: color-mix(in srgb, var(--tn-cyan) 45%, transparent);
  }
</style>

<script is:inline>
  (() => {
    const bind = () => {
      const btn = document.getElementById("theme-toggle-btn");
      if (!btn || btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        if (typeof window.toggleTheme === "function") window.toggleTheme();
        else document.documentElement.classList.toggle("dark");
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bind, { once: true });
    } else {
      bind();
    }

    document.addEventListener("astro:after-swap", () => {
      const btn = document.getElementById("theme-toggle-btn");
      if (btn) delete btn.dataset.bound;
      bind();
    });
  })();
</script>
