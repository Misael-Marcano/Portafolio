---
interface Props {
  href: string;
  class?: string;
  download?: boolean;
}

const { href, class: className, download } = Astro.props;

// Los enlaces externos abren en otra pestaña
const isExternal = href.startsWith("http");
---

<a
  href={href}
  download={download}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  role="link"
  class={`inline-flex items-center justify-center gap-2 px-4 py-1.5
  font-mono text-sm
  text-tn-muted
  transition duration-300
  bg-tn-panel-2
  border border-tn-border/70
  rounded-md

  before:content-['['] after:content-[']']
  before:text-tn-comment after:text-tn-comment
  before:transition-colors after:transition-colors

  hover:text-tn-cyan hover:border-tn-cyan/60
  hover:before:text-tn-cyan hover:after:text-tn-cyan
  hover:-translate-y-0.5
  hover:shadow-[0_4px_16px_-4px_var(--tn-glow)]

  focus:outline-none focus-visible:outline-none
  focus-visible:ring-2 focus-visible:ring-tn-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-tn-bg

  group max-w-fit
  ${className ?? ""}`}
>
  <slot />
</a>

<style>
  a {
    transition-property: background-color, border-color, color, transform,
      box-shadow;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }

  a :global(svg) {
    transition-property: color;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }
</style>
