---
import es from "../i18n/es.json";
interface Props {
  dateKey: string;
  titleKey: string;
  title2Key?: string;
  descriptionKey: string;
  link?: string;
  ctaKey?: string;
}

const {
  dateKey,
  titleKey,
  title2Key,
  descriptionKey,
  link,
  ctaKey = "exp_more",
} = Astro.props;

const fb = (key?: string) => {
  if (!key) return "";
  return (es as Record<string, string>)[key] ?? "";
};
---

<div
  class="relative ml-7 mr-1 sm:mx-8 md:mx-12 pb-12 grid min-w-0 before:absolute before:left-[-24px] sm:before:left-[-30px] md:before:left-[-35px] before:block before:h-full before:border-l-2 before:border-dashed before:border-tn-border before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4"
>
  <div class="relative pb-8 md:pb-12 md:col-span-2 min-w-0">
    <div class="sticky top-20">
      <!-- Nodo de commit -->
      <span
        class="absolute -left-[31px] sm:-left-[37px] md:-left-[42px] top-1 flex h-4 w-4 items-center justify-center"
        aria-hidden="true"
      >
        <span class="h-3.5 w-3.5 rounded-full border-2 border-tn-cyan bg-tn-bg"></span>
      </span>

      <!-- Título principal -->
      <h3 class="text-lg sm:text-xl font-bold text-tn-cyan text-balance" data-i18n={titleKey}>
        {fb(titleKey)}
      </h3>

      <!-- Empresa -->
      {
        title2Key && (
          <h4 class="font-semibold text-base sm:text-lg text-tn-text" data-i18n={title2Key}>
            {fb(title2Key)}
          </h4>
        )
      }

      <!-- Fecha -->
      <time
        class="p-0 m-0 font-mono text-xs text-tn-muted"
        data-i18n={dateKey}
      >
        {fb(dateKey)}
      </time>
    </div>
  </div>

  <!-- Contenido derecho -->
  <div class="relative flex flex-col gap-2 pb-4 text-tn-muted md:col-span-3 min-w-0">
    <p class="text-sm sm:text-base font-normal text-pretty" data-i18n={descriptionKey}>
      {fb(descriptionKey)}
    </p>

    {
      link && (
        <a
          href={link}
          role="link"
          class="inline-flex items-center font-mono text-sm font-medium text-tn-green hover:text-tn-cyan transition-colors duration-300 no-underline w-fit"
        >
          <span data-i18n={ctaKey}>{fb(ctaKey) || "Saber más..."}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </a>
      )
    }
  </div>
</div>

<style>
  .sticky {
    position: sticky;
  }
</style>
