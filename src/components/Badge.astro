---
interface Props {
  class?: string;
  href?: string;
  [key: string]: any;
}

const { class: className, href, ...rest } = Astro.props;
const isLink = href !== undefined;
---

{
  isLink ? (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center transition md:hover:scale-105"
    >
      <span class="relative inline-flex overflow-hidden rounded-md p-px">
        <!-- Animación de borde giratorio -->
        <span class="absolute inset-[-1000%] animate-[spin_2.5s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,var(--tn-green)_0%,transparent_50%,var(--tn-green)_100%)]"></span>

        <!-- Contenido del badge -->
        <div
          {...rest}
          class={`relative inline-flex items-center justify-center w-full px-3 py-1 text-xs font-mono rounded-md cursor-pointer whitespace-nowrap z-10 transition-colors duration-300
          bg-tn-panel-2 text-tn-green border border-tn-green/30
          ${className ?? ""}`}
        >
          <!-- Puntito pulsante -->
          <span class="relative flex h-2 w-2 mr-2">
            <span class="animate-pulse absolute inline-flex h-full w-full rounded-full bg-tn-green opacity-75"></span>
            <span class="relative inline-flex rounded-full h-full w-full bg-tn-green"></span>
          </span>

          <slot />
        </div>
      </span>
    </a>
  ) : (
    <span class="inline-flex items-center transition">
      <span class="relative inline-flex overflow-hidden rounded-md p-px">
        <!-- Animación de borde giratorio -->
        <span class="absolute inset-[-1000%] animate-[spin_2.5s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,var(--tn-green)_0%,transparent_50%,var(--tn-green)_100%)]"></span>

        <!-- Contenido del badge -->
        <div
          {...rest}
          class={`relative inline-flex items-center justify-center w-full px-3 py-1 text-xs font-mono rounded-md cursor-pointer whitespace-nowrap z-10 transition-colors duration-300
          bg-tn-panel-2 text-tn-green border border-tn-green/30
          ${className ?? ""}`}
        >
          <!-- Puntito pulsante -->
          <span class="relative flex h-2 w-2 mr-2">
            <span class="animate-pulse absolute inline-flex h-full w-full rounded-full bg-tn-green opacity-75"></span>
            <span class="relative inline-flex rounded-full h-full w-full bg-tn-green"></span>
          </span>

          <slot />
        </div>
      </span>
    </span>
  )
}
