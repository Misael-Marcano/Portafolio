          exp_2_desc:
            "For nearly a year, developed and maintained applications focused on policy management, claims, and administrative processes. Implemented functional improvements and fixes that ensured daily system operation, collaborating with internal teams to adapt technology solutions to business needs.",
          projects: "Projects",
          proj_1_title: "Jokes Configurator",
          proj_1_desc:
            "Project focused on the consumption of a public REST API (JokeAPI v2) to obtain jokes in real time. It implements HTTP requests, handles responses in JSON format, and filters by category and content type.",
          proj_1_alt: "Screenshot of the project Jokes Configurator",
          btn_code: "Code",
          btn_preview: "Preview",
          tag_js: "JavaScript",
          tag_css: "CSS",
          tag_ejs: "EJS",
          aboutme_strong_1:
            "I’m passionate about technology, software development, and continuous learning",
          aboutme_text_1:
            ". I enjoy turning ideas into functional solutions, writing clean code, and taking on challenges that push me to think differently and improve every day. I like programming as much as I like ",
          aboutme_strong_2:
            "video games, because both train my mind: strategy, logic, patience, and focus on results.",
          aboutme_strong_3: "The gym is a key part of my daily discipline;",
          aboutme_text_2:
            " it helps me stay consistent, mentally strong, and balanced between mind and body—something I also apply to my projects. I’m curious, self-taught, and growth-minded.",
          aboutme_text_3:
            "I’m always learning new technologies, best practices, and more efficient ways of doing things.",
          aboutme_strong_4:
            "I adapt quickly, work well in teams, and enjoy contributing ideas that add real value.",
        },
      };

      const getLang = () =>
        localStorage.getItem("language") === "en" ? "en" : "es";

      const loadDict = (lang) => i18nData[lang] || {};

      const applyTextI18n = (dict) => {
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.dataset.i18n;
          if (key && dict[key]) {
            el.textContent = dict[key];
          }
        });
      };

      const applyAttrI18n = (dict) => {
        document.querySelectorAll("[data-i18n-attr]").forEach((el) => {
          const attr = el.getAttribute("data-i18n-attr");
          if (!attr) return;

          const key = el.getAttribute(`data-i18n-${attr}`);
          if (key && dict[key]) {
            el.setAttribute(attr, dict[key]);
          }
        });
      };

      const applyI18n = (lang) => {
        const l = lang || getLang();
        document.documentElement.lang = l;
        const dict = loadDict(l);
        applyTextI18n(dict);
        applyAttrI18n(dict);
      };

      window.addEventListener("languageChange", (e) => {
        const l = e?.detail?.language === "en" ? "en" : "es";
        applyI18n(l);
      });

      const boot = () => applyI18n();

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot, { once: true });
      } else {
        boot();
      }

      document.addEventListener("astro:page-load", boot);
      document.addEventListener("astro:after-swap", boot);
    </script>
  </head>

  <body class="bg-tn-bg text-tn-text min-h-screen flex flex-col overflow-x-clip">
    <LoadingScreen />
    <div id="top"></div>

    <!-- Fondo tecnológico animado: cuadrícula, orbes de luz y partículas -->
    <div class="tech-bg" aria-hidden="true">
      <div class="tech-grid"></div>
      <div class="tech-orb tech-orb-1"></div>
      <div class="tech-orb tech-orb-2"></div>
      {
        Array.from({ length: 14 }).map((_, i) => (
          <span
            class="tech-particle"
            style={`--px:${(i * 7.3 + 3) % 100}%; --pd:${((i * 3.7) % 14).toFixed(1)}s; --pt:${16 + (i % 5) * 5}s; --ps:${2 + (i % 3)}px;`}
          />
        ))
      }
    </div>

    <Header />

    <main class="flex-1 w-full min-w-0">
      <slot />
    </main>

    <Footer />

    <div id="konami-toast" role="status">ACHIEVEMENT UNLOCKED — konami.code</div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
  }
  html {
    font-family: "Onest Variable", sans-serif;
    /* Solo smooth tras la carga: evita saltos raros con scroll restoration */
    scroll-behavior: auto;
    /* clip (no hidden): evita overflow-y:auto implícito = doble scrollbar */
    overflow-x: clip;
  }
  body {
    overflow-x: clip;
    overflow-y: visible;
  }
  main {
    overflow: visible;
  }
  html.smooth-scroll {
    scroll-behavior: smooth;
  }
  ::selection {
    background: var(--tn-blue);
    color: var(--tn-bg);
  }
  @media (prefers-reduced-motion: reduce) {
    html,
    html.smooth-scroll {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  // ===== Scroll estable al recargar =====
  // El navegador restaura la posición; smooth en <html> la anima mal.
  // Manual + reaplicar sin animación = posición coherente y sin saltos.
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }

  const restoreScroll = () => {
    const hash = window.location.hash;
    if (hash && hash !== "#top") {
      const el = document.querySelector(hash);
      if (el instanceof HTMLElement) {
        const nav = document.getElementById("main-nav");
        const offset = nav ? Math.ceil(nav.getBoundingClientRect().height + 16) : 72;
        window.scrollTo(0, Math.max(0, el.offsetTop - offset));
        return;
      }
    }
    // Sin hash: ir al top (evita aterrizar a mitad con .reveal aún oculto)
    window.scrollTo(0, 0);
  };

  // Activar smooth solo para clics de navegación, no para la restauración inicial
  const enableSmoothScroll = () => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("smooth-scroll");
    }
  };

  // ===== Reveal: tras boot screen todo visible de una vez =====
  // El LoadingScreen añade html.is-ready y marca .reveal.visible.
  // Aquí solo hay fallback si no hay boot o reduced-motion ya lo resolvió.
  const initReveal = () => {
    const els = [...document.querySelectorAll<HTMLElement>(".reveal")];
    if (els.length === 0) return;

    // Si el boot ya terminó (o se saltó), mostrar todo
    if (document.documentElement.classList.contains("is-ready")) {
      els.forEach((el) => el.classList.add("visible"));
      return;
    }

    // Fallback sin boot-screen: mostrar todo al load (sin escalonado)
    const showAll = () => {
      document.documentElement.classList.add("is-ready");
      els.forEach((el) => el.classList.add("visible"));
    };

    if (document.readyState === "complete") showAll();
    else window.addEventListener("load", showAll, { once: true });
  };

  // ===== Spotlight que sigue el cursor (efecto Linear) =====
  const initSpotlight = () => {
    document.querySelectorAll<HTMLElement>(".spotlight-card").forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--x", `${e.clientX - r.left}px`);
        card.style.setProperty("--y", `${e.clientY - r.top}px`);
      });
    });
  };

  // ===== Konami code easter egg =====
  const initKonami = () => {
    const seq = [
      "ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown",
      "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight",
      "b", "a",
    ];
    let idx = 0;
    document.addEventListener("keydown", (e) => {
      idx = e.key === seq[idx] ? idx + 1 : e.key === seq[0] ? 1 : 0;
      if (idx !== seq.length) return;
      idx = 0;
      document.body.classList.remove("konami-active");
      void document.body.offsetWidth; // reinicia la animación si se repite
      document.body.classList.add("konami-active");
      const toast = document.getElementById("konami-toast");
      toast?.classList.add("show");
      setTimeout(() => toast?.classList.remove("show"), 3000);
    });
  };

  restoreScroll();
  // Avisa al scroll-spy del Header tras fijar la posición
  window.dispatchEvent(new Event("scroll"));
  initReveal();
  initSpotlight();
  initKonami();
  // Smooth solo después de estabilizar la posición inicial
  requestAnimationFrame(() => requestAnimationFrame(enableSmoothScroll));
</script>
