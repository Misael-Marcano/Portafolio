---
import "@fontsource-variable/onest";
import "@fontsource-variable/jetbrains-mono";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={`${base}code.ico`} sizes="any" />

    <title>{title}</title>

    <script is:inline>
      (() => {
        // ====== THEME ======
        const getTheme = () => {
          const stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") return stored;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        };

        const applyTheme = (theme) => {
          document.documentElement.classList.toggle("dark", theme === "dark");
          localStorage.setItem("theme", theme);
        };

        // Inicializa tema temprano
        applyTheme(getTheme());

        // Expone toggle global
        window.toggleTheme = () => {
          const isDark = document.documentElement.classList.contains("dark");
          applyTheme(isDark ? "light" : "dark");
        };

        // ====== LANGUAGE ======
        window.changeLanguage = (lang) => {
          const safe = lang === "en" ? "en" : "es";
          localStorage.setItem("language", safe);
          document.documentElement.lang = safe;

          window.dispatchEvent(
            new CustomEvent("languageChange", { detail: { language: safe } }),
          );
        };

        // Inicializa lang del HTML
        document.documentElement.lang =
          localStorage.getItem("language") === "en" ? "en" : "es";
      })();
    </script>

    <script is:inline type="module">
      import "/src/scripts/i18n.ts";
    </script>
  </head>

  <body class="bg-tn-bg text-tn-text min-h-screen flex flex-col">
    <div id="top"></div>

    <!-- Fondo tecnológico animado: cuadrícula, orbes de luz y partículas -->
    <div class="tech-bg" aria-hidden="true">
      <div class="tech-grid"></div>
      <div class="tech-orb tech-orb-1"></div>
      <div class="tech-orb tech-orb-2"></div>
      {
        Array.from({ length: 14 }).map((_, i) => (
          <span
            class="tech-particle"
            style={`--px:${(i * 7.3 + 3) % 100}%; --pd:${((i * 3.7) % 14).toFixed(1)}s; --pt:${16 + (i % 5) * 5}s; --ps:${2 + (i % 3)}px;`}
          />
        ))
      }
    </div>

    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <div id="konami-toast" role="status">ACHIEVEMENT UNLOCKED — konami.code</div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
  }
  html {
    font-family: "Onest Variable", sans-serif;
    scroll-behavior: smooth;
  }
  ::selection {
    background: var(--tn-blue);
    color: var(--tn-bg);
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  // ===== Reveal on scroll =====
  const initReveal = () => {
    const els = document.querySelectorAll<HTMLElement>(".reveal");
    if (!("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("visible"));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );
    els.forEach((el) => observer.observe(el));
  };

  // ===== Spotlight que sigue el cursor (efecto Linear) =====
  const initSpotlight = () => {
    document.querySelectorAll<HTMLElement>(".spotlight-card").forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--x", `${e.clientX - r.left}px`);
        card.style.setProperty("--y", `${e.clientY - r.top}px`);
      });
    });
  };

  // ===== Konami code easter egg =====
  const initKonami = () => {
    const seq = [
      "ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown",
      "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight",
      "b", "a",
    ];
    let idx = 0;
    document.addEventListener("keydown", (e) => {
      idx = e.key === seq[idx] ? idx + 1 : e.key === seq[0] ? 1 : 0;
      if (idx !== seq.length) return;
      idx = 0;
      document.body.classList.remove("konami-active");
      void document.body.offsetWidth; // reinicia la animación si se repite
      document.body.classList.add("konami-active");
      const toast = document.getElementById("konami-toast");
      toast?.classList.add("show");
      setTimeout(() => toast?.classList.remove("show"), 3000);
    });
  };

  initReveal();
  initSpotlight();
  initKonami();
</script>
