---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import fotoPerfil from "../assets/Foto_perfil.jpg";
import LinkedInIcon from "../components/icons/LinkedIn.astro";
import GitHubIcon from "../components/icons/GitHub.astro";
// import MailIcon from "../components/icons/mail.astro";
import SocialPill from "../components/SocialPill.astro";
import Experience from "../components/experience.astro";
import SectionContainer from "../components/SectionContainer.astro";
import BriefcaseIcon from "../components/icons/Briefcase.astro";
import ProjectsIcon from "../components/icons/Projects.astro";
import Projects from "../components/Projects.astro";
import UserIcon from "../components/icons/User.astro";
import CurriculumIcon from "../components/icons/Curriculum.astro";
import ContactIcon from "../components/icons/Contact.astro";
import Aboutme from "../components/Aboutme.astro";
import Preparacion from "../components/Preparacion.astro";
import CertificateIcon from "../components/icons/Certificate.astro";

// Actions a veces pasa --base /Portafolio sin slash → evita /Portafoliocv/...
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const cvHref = `${base}cv/Misael-Marcano-CV.pdf`;
---

<Layout
  title="Portafolio de Misael - Desarrollador Oracle Forms, Oracle Reports y Web"
  description="Contrata a Misael para crear tu aplicación web. Desarrollador Web. Especializado en crear aplicaciones únicas."
>
  <div class="px-4 w-full min-w-0 overflow-x-clip">
    <SectionContainer class="pt-28 sm:pt-32 md:pt-40 pb-16 sm:pb-24">
      <!-- Ventana de terminal -->
      <div
        class="rounded-xl border border-tn-border/70 bg-tn-panel/60 backdrop-blur-sm shadow-2xl shadow-black/10 dark:shadow-black/40 overflow-hidden spotlight-card"
      >
        <!-- Barra de título -->
        <div
          class="flex items-center gap-2.5 px-3 sm:px-4 py-2.5 border-b border-tn-border/60 bg-tn-panel-2/80 font-mono min-w-0"
        >
          <span class="ps-sym text-sm text-[#2dd4bf]" aria-hidden="true">△</span>
          <span class="ps-sym text-sm text-[#f7768e]" aria-hidden="true">○</span>
          <span class="ps-sym text-sm text-[#7aa2f7]" aria-hidden="true">✕</span>
          <span class="ps-sym text-sm text-[#bb9af7]" aria-hidden="true">□</span>
          <span class="ml-2 sm:ml-3 text-xs text-tn-comment truncate min-w-0">
            misael@dev: ~
          </span>
        </div>

        <!-- Cuerpo del terminal -->
        <div class="p-4 sm:p-6 md:p-8">
          <p class="font-mono text-xs sm:text-sm text-tn-comment mb-6 overflow-x-auto">
            <span class="text-tn-green">misael@dev</span><span>:</span><span class="text-tn-blue">~</span><span>$</span>
          </p>

          <!-- Output estilo neofetch -->
          <div class="hero-output flex flex-col sm:flex-row gap-5 sm:gap-8 items-start min-w-0">
            <img
              class="rounded-lg w-20 h-20 sm:w-28 sm:h-28 object-cover ring-1 ring-tn-border shadow-lg shrink-0"
              src={fotoPerfil.src}
              alt="misael photo"
            />

            <div class="min-w-0 w-full">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2 sm:gap-x-4 sm:gap-y-3 mb-4">
                <h1
                  class="text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-tn-text text-balance"
                  data-i18n-attr="aria-label"
                  data-i18n-aria-label="welcome_title"
                  aria-label="Hey, soy Misael"
                >
                  <span class="inline-flex flex-wrap items-baseline gap-x-2 gap-y-1" aria-hidden="true">
                    <span data-i18n="welcome_greeting">Hey, soy</span>
                    <span class="typewriter-name font-mono text-tn-cyan">
                      <span
                        class="typewriter-text"
                        data-typewriter-name
                        data-typewriter-value="Misael"
                      ></span><span class="typewriter-caret" aria-hidden="true"></span>
                    </span>
                  </span>
                </h1>
                <Badge
                  data-i18n="status_available"
                  href="https://www.linkedin.com/in/misael-marcano/"
                  >Disponible para trabajar</Badge
                >
              </div>

              <p class="text-base sm:text-xl text-tn-muted text-pretty">
                <span data-i18n="desc_part_1">
                  Desarrollador de software con 3 años de experiencia en
                  desarrollo y soporte de aplicaciones con Oracle Forms y Oracle
                  Reports
                </span>,
                <strong data-i18n="desc_part_2" class="font-semibold text-tn-cyan">
                  construyendo y manteniendo sistemas críticos.
                </strong>
                <span data-i18n="desc_part_4">
                  Especializado en aplicaciones funcionales.
                </span>
              </p>
            </div>
          </div>

          <!-- Pills como comandos -->
          <nav class="hero-output flex flex-wrap gap-2 sm:gap-3 mt-6 sm:mt-8">
            <SocialPill href="mailto:misaelmarcano0530@gmail.com">
              <ContactIcon class="size-4" />
              <span data-i18n="contact_title">Contáctame</span>
            </SocialPill>

            <SocialPill href="https://www.linkedin.com/in/misael-marcano/">
              <LinkedInIcon class="size-4" />
              LinkedIn
            </SocialPill>

            <SocialPill href="https://github.com/Misael-Marcano">
              <GitHubIcon class="size-4" />
              GitHub
            </SocialPill>

            <SocialPill href={cvHref} download="Misael-Marcano-CV.pdf" newTab>
              <CurriculumIcon class="size-4" />
              <span data-i18n="download_cv">Descargar CV</span>
            </SocialPill>
          </nav>

          <p class="font-mono text-xs sm:text-sm text-tn-comment mt-6 sm:mt-8 term-cursor overflow-x-auto">
            <span class="text-tn-green">misael@dev</span><span>:</span><span class="text-tn-blue">~</span><span>$</span>
          </p>
        </div>
      </div>
    </SectionContainer>

    <SectionContainer id="experiencia" class="reveal">
      <h2
        class="text-2xl sm:text-3xl font-semibold mb-2 flex gap-x-3 items-center flex-wrap"
      >
        <BriefcaseIcon class="size-6 sm:size-7 text-tn-cyan shrink-0" />
        <span data-i18n="section_experience_title" class="text-tn-text"
          >Experiencia laboral</span
        >
      </h2>
      <Experience />
    </SectionContainer>

    <SectionContainer id="proyectos" class="py-16 sm:py-20 reveal">
      <h2
        class="flex items-center mb-6 text-2xl sm:text-3xl font-semibold gap-x-3 text-tn-text flex-wrap"
      >
        <ProjectsIcon class="size-7 sm:size-10 text-tn-cyan shrink-0" />
        <span data-i18n="projects">Proyectos</span>
      </h2>
      <Projects />
    </SectionContainer>

    <SectionContainer id="preparacion" class="py-16 sm:py-20 reveal">
      <h2
        class="flex items-center mb-6 text-2xl sm:text-3xl font-semibold gap-x-3 text-tn-text flex-wrap"
      >
        <CertificateIcon class="size-7 sm:size-10 text-tn-cyan shrink-0" />
        <span data-i18n="section_prep_title">Preparación Profesional</span>
      </h2>
      <p
        class="font-mono text-sm text-tn-muted mb-6 max-w-2xl text-pretty"
        data-i18n="section_prep_subtitle"
      >
        Certificaciones y diplomas.
      </p>
      <Preparacion />
    </SectionContainer>

    <SectionContainer id="sobremi" class="py-16 sm:py-20 reveal">
      <h2
        class="flex items-center mb-6 text-2xl sm:text-3xl font-semibold gap-x-3 text-tn-text flex-wrap"
      >
        <UserIcon class="size-7 sm:size-10 text-tn-cyan shrink-0" />
        <span data-i18n="section_about_title">Sobre mí</span>
      </h2>
      <Aboutme />
    </SectionContainer>
  </div>
</Layout>

<style>
  /* Nombre tipado como código en el H1 */
  .typewriter-name {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
  }
  .typewriter-caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.05em;
    margin-left: 2px;
    background: var(--tn-green, #9ece6a);
    vertical-align: text-bottom;
    animation: typewriter-blink 1.05s step-end infinite;
  }
  .typewriter-name.is-done .typewriter-caret {
    opacity: 0.85;
  }
  @keyframes typewriter-blink {
    50% {
      opacity: 0;
    }
  }

  /* El contenido del hero aparece primero, casi de inmediato */
  .hero-output {
    opacity: 0;
    animation: output-in 0.5s ease 0.15s forwards;
  }
  @keyframes output-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-caret {
      display: none;
    }
    .hero-output {
      opacity: 1;
      animation: none;
    }
  }
</style>
<!-- Duracion del tipado para el nombre -->
<script>
  const TYPE_MS = 160;
  let typeTimer: ReturnType<typeof setInterval> | null = null;
  let waitingForBoot = false;

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const typewriteName = () => {
    const el = document.querySelector<HTMLElement>("[data-typewriter-name]");
    if (!el) return;

    const wrap = el.closest(".typewriter-name");
    const full = el.dataset.typewriterValue || "Misael";

    if (typeTimer) {
      clearInterval(typeTimer);
      typeTimer = null;
    }

    wrap?.classList.remove("is-done");

    if (prefersReducedMotion()) {
      el.textContent = full;
      wrap?.classList.add("is-done");
      return;
    }

    el.textContent = "";
    let i = 0;
    typeTimer = setInterval(() => {
      i += 1;
      el.textContent = full.slice(0, i);
      if (i >= full.length) {
        if (typeTimer) clearInterval(typeTimer);
        typeTimer = null;
        wrap?.classList.add("is-done");
      }
    }, TYPE_MS);
  };

  /** Arranca tras el fade del loading; si no hay boot, de inmediato. */
  const scheduleTypewriter = () => {
    const boot = document.getElementById("boot-screen");
    const ready = document.documentElement.classList.contains("is-ready");

    if (!boot || ready) {
      typewriteName();
      return;
    }

    if (waitingForBoot) return;
    waitingForBoot = true;
    window.addEventListener(
      "boot:done",
      () => {
        waitingForBoot = false;
        typewriteName();
      },
      { once: true },
    );
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", scheduleTypewriter, {
      once: true,
    });
  } else {
    scheduleTypewriter();
  }

  document.addEventListener("astro:page-load", scheduleTypewriter);
  document.addEventListener("astro:after-swap", scheduleTypewriter);
  // Cambio de idioma: la página ya es visible → reinicia al momento
  window.addEventListener("languageChange", () => typewriteName());
</script>
